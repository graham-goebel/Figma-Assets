{
  "name": "social-post-composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "typecheck": "npm run typecheck --workspace client && npm run typecheck --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
